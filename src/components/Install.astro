---
import { t, type Lang } from '../i18n/strings';
import CopyCommand from './CopyCommand.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const ins = s.install;
const featured = ins.methods[0];
const others = ins.methods.slice(1);
---

<section id="install" class="install bleed-bean">
  <div class="install__dough" aria-hidden="true">
    <svg viewBox="0 0 1440 70" preserveAspectRatio="none" width="100%" height="100%">
      <path d="M0,0 L1440,0 L1440,30 C1200,64 960,38 720,46 C480,54 240,72 0,36 Z" fill="var(--dough-100)"></path>
    </svg>
  </div>

  <div class="section wrap">
    <div class="install__head reveal">
      <p class="eyebrow">{ins.eyebrow}</p>
      <h2>{ins.title}</h2>
      <p class="install__sub measure">{ins.subtitle}</p>
    </div>

    <div class="install__grid">
      <article class="method method--featured reveal">
        <header class="method__head">
          <h3>{featured.title}</h3>
          {featured.tag && <span class="tag">{featured.tag}</span>}
        </header>
        <p class="method__body">{featured.body}</p>
        {featured.command && (
          <CopyCommand command={featured.command} copyLabel={ins.copy} copiedLabel={ins.copied} tone="bean" />
        )}
      </article>

      {others.map((m, i) => (
        <article class="method reveal" data-delay={i + 1}>
          <header class="method__head">
            <h3>{m.title}</h3>
          </header>
          <p class="method__body">{m.body}</p>
          {m.command && (
            <CopyCommand command={m.command} copyLabel={ins.copy} copiedLabel={ins.copied} tone="bean" />
          )}
          {m.cta && (
            <a class="btn method__cta" href={m.cta.href} target="_blank" rel="noopener">
              {m.cta.label}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          )}
        </article>
      ))}
    </div>

    <aside class="perms reveal">
      <span class="perms__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6l-8-3Z" stroke-linejoin="round"></path>
          <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <div>
        <strong>{ins.permsTitle}</strong>
        <p>{ins.perms}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .install {
    position: relative;
    background: radial-gradient(120% 90% at 30% 0%, var(--bean-700), var(--bean-800));
  }
  .install__dough {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: clamp(36px, 4.5vw, 70px);
    line-height: 0;
  }
  .install .section {
    padding-top: clamp(4rem, 8vw, 6.5rem);
  }
  .install__head {
    max-width: 42rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .install__head .eyebrow {
    margin-bottom: 0.9rem;
  }
  .install__sub {
    margin-top: 1rem;
    color: var(--on-bean-70);
    font-size: 1.08rem;
    line-height: 1.6;
  }
  .install__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2.2vw, 1.5rem);
  }
  .method {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    background: oklch(0.965 0.014 80 / 0.06);
    border: 1px solid oklch(0.965 0.014 80 / 0.16);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .method--featured {
    grid-column: 1 / -1;
    background: oklch(0.965 0.014 80 / 0.1);
  }
  .method__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .method__head h3 {
    font-size: 1.35rem;
    color: var(--on-bean);
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--bean-800);
    background: var(--blush);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }
  .method__body {
    color: var(--on-bean-70);
    line-height: 1.6;
    margin-top: -0.25rem;
  }
  .method__cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .perms {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: 1.25rem 1.5rem;
    background: oklch(0.2 0.06 27 / 0.35);
    border-radius: var(--radius);
    border: 1px solid oklch(0.965 0.014 80 / 0.12);
  }
  .perms__icon {
    flex-shrink: 0;
    color: var(--blush);
    margin-top: 0.15rem;
  }
  .perms strong {
    display: block;
    color: var(--on-bean);
    font-family: var(--font-display);
    font-weight: 680;
    margin-bottom: 0.25rem;
  }
  .perms p {
    color: var(--on-bean-70);
    line-height: 1.6;
    font-size: 0.96rem;
    max-width: 60ch;
  }

  @media (max-width: 680px) {
    .install__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
