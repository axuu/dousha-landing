---
import { t, type Lang } from '../i18n/strings';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const fo = s.footer;
const year = 2026;
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <img src="/dousha-icon.png" width="52" height="52" alt={s.hero.iconAlt} class="footer__mark" />
      <p class="footer__tagline">{fo.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label={lang === 'zh' ? '页脚链接' : 'Footer'}>
      {fo.nav.map((l) => (
        <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
      ))}
    </nav>

    <div class="footer__meta">
      <p class="footer__credits">{fo.credits}</p>
      <p class="footer__legal">
        <span>© {year} Dousha · {fo.builtBy}</span>
        <a href="#top" class="footer__top">
          {fo.backToTop}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bean-900);
    color: var(--on-bean-70);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .footer__mark {
    border-radius: 12px;
    box-shadow: 0 6px 18px oklch(0.15 0.05 27 / 0.5);
    flex-shrink: 0;
  }
  .footer__tagline {
    font-family: var(--font-display);
    font-weight: 680;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--on-bean);
    text-wrap: balance;
  }
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-weight: 500;
  }
  .footer__nav a {
    color: var(--on-bean-70);
    width: fit-content;
    transition: color 0.2s ease;
  }
  .footer__nav a:hover {
    color: var(--on-bean);
  }
  .footer__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    border-top: 1px solid oklch(0.965 0.014 80 / 0.14);
    font-size: 0.9rem;
  }
  .footer__credits {
    max-width: 46ch;
  }
  .footer__legal {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--blush);
    font-weight: 600;
    transition: gap 0.2s ease;
  }
  .footer__top:hover {
    gap: 0.55rem;
  }

  @media (max-width: 640px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
